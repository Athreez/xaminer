# Copy to deploy/.env and change every value marked change-me.
# deploy/.env is git-ignored. Never commit real secrets.

# Port the app is served on (http://localhost:<WEB_PORT>)
WEB_PORT=8080
# HTTPS port (https://localhost:<WEB_HTTPS_PORT>), with a self-signed certificate for CERT_HOSTS
# (names or IPs, comma-separated). `make demo-https` adds this laptop's Wi-Fi address.
WEB_HTTPS_PORT=8443
CERT_HOSTS=localhost,127.0.0.1

# development | production  (production hides the API docs page)
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL. POSTGRES_USER/PASSWORD is the superuser: only postgres and db-init get it.
POSTGRES_DB=xaminer
POSTGRES_USER=xaminer
POSTGRES_PASSWORD=change-me
# `migrator` owns the tables (used only by migrations); `app` reads/writes rows (used by the backend)
DB_MIGRATOR_PASSWORD=change-me
DB_APP_PASSWORD=change-me
# Host port for local DB tools (15432 avoids clashing with a locally installed PostgreSQL)
POSTGRES_HOST_PORT=15432

# Redis (Celery broker, rate limits, caches)
REDIS_PASSWORD=change-me
# Host port for local tools and tests
REDIS_HOST_PORT=16379

# Object storage (SeaweedFS, S3-compatible)
S3_ACCESS_KEY=xaminer
S3_SECRET_KEY=change-me-at-least-16-chars

# Signs login tokens. At least 32 random characters; the API refuses to start otherwise.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-value

# Address users open the app at; used for links in emails (`make demo-https` sets it).
PUBLIC_BASE_URL=http://localhost:8080

# Email. Leave as is in development: Mailpit catches everything at http://localhost:8025.
# For real email with Gmail (README, "Real email"): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_STARTTLS=true, SMTP_USERNAME=you@gmail.com, SMTP_PASSWORD=<16-letter app password>,
# MAIL_FROM=Xaminer <you@gmail.com>.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Xaminer <no-reply@xaminer.local>
